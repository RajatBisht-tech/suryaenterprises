# Copy to .env.local and fill in real values.

MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
DB_NAME=SURYAENTERPRISES

PAYU_ENV=test
PAYU_KEY=<payu merchant key>
PAYU_SALT=<payu merchant salt>

PUBLIC_BASE_URL=http://localhost:3000

PAYIN_API_TOKEN=<long random token; must match SURYA_PAYIN_API_TOKEN in Payin-Backend>

# PAYIN_BACKEND_WEBHOOK_URL=http://localhost:8001/api/webhooks/payu/payment
# RAZORPAY_KEY=rzp_live_...
# RAZORPAY_SECRET=...
# RAZORPAY_MERCHANT_VPA=suryaenterprise391259.rzp@rxairtel

# Customer account sessions (httpOnly cookie JWT), at least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CUSTOMER_JWT_SECRET=<long random secret>
